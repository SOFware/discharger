#!/usr/bin/env ruby

# GENERATED BY DISCHARGER. DO NOT EDIT. Edits here are lost on regeneration.
#
# App setup belongs in config/setup.yml (pre_steps, steps, custom_steps).
# Script changes belong in the discharger gem's template,
# lib/generators/discharger/install/templates/setup; release it, bump it, then
#   bin/rails generate discharger:install --setup-only --force

script = File.expand_path(__FILE__)
Dir.chdir(File.expand_path("..", __dir__))

# First pass, standard library only: the bundle may not exist yet. Re-exec
# under bundle exec before yaml loads, or a default psych clashes with Gemfile.lock.
# Mirrors the github_packages and bundler steps, which re-run under bundle exec.
unless ENV["DISCHARGER_SETUP_BUNDLED"]
  def store_github_packages_credentials
    require "yaml"
    source = begin
      YAML.safe_load_file("config/setup.yml")&.dig("github_packages", "source")
    rescue SystemCallError, Psych::Exception
      nil # reported by Discharger::Setup on the second pass
    end
    return if source.to_s.empty?
    unless `gh auth status 2>&1`.include?("read:packages")
      warn "Skipping #{source} credentials: the gh token lacks read:packages (gh auth refresh -s read:packages)"
      return
    end

    username = `gh api user --jq .login 2>/dev/null`.strip
    token = `gh auth token 2>/dev/null`.strip
    return if username.empty? || token.empty?

    system("bundle", "config", "set", "--local", source, "#{username}:#{token}", out: File::NULL, err: File::NULL)
  end

  unless system("bundle", "check", out: File::NULL, err: File::NULL)
    store_github_packages_credentials
    system("bundle", "install") || abort(<<~MSG)

      == bundle install failed ==
      If the Gemfile uses a private GitHub Packages source, run `gh auth login`
      (or `gh auth refresh -s read:packages`) and rerun bin/setup.
    MSG
  end

  exec({"DISCHARGER_SETUP_BUNDLED" => "1"}, "bundle", "exec", RbConfig.ruby, script, *ARGV)
end

require "discharger/setup"
Discharger::Setup.run("config/setup.yml")
